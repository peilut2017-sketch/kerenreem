# ============================================================================
# מכון קרן רא"ם — משתני סביבה
# העתיקו לקובץ .env.local ומלאו את הערכים מלוח הבקרה של Supabase.
# ============================================================================

# כתובת הפרויקט ב-Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# מפתח ציבורי (anon / publishable) — מותר בצד הלקוח, כפוף ל-RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# מפתח שירות — עוקף RLS. שרת בלבד. לעולם לא עם קידומת NEXT_PUBLIC_.
# נדרש רק לפעולות שרת (סליקה, יצירת הזמנות) בשלב ב'.
SUPABASE_SERVICE_ROLE_KEY=

# כתובת הבסיס הציבורית של האתר — משמשת ל-sitemap, robots ומטא-תגיות
NEXT_PUBLIC_SITE_URL=https://www.kerenreem.org.il

# דומיין ה-CDN (Cloudflare) שמונח מול Supabase Storage, להפחתת ה-Egress
# שלה — CNAME ב-Cloudflare שמצביע על <project-ref>.supabase.co, מופעל
# דרך הענן הכתום, עם Cache Rule מפורש על /storage/v1/object/public/*
# (ברירת המחדל של Cloudflare לא בהכרח שומרת במטמון נתיב API כזה). רשות —
# בלעדיו נשמרת כתובת ה-Storage המקורית של Supabase כרגיל.
NEXT_PUBLIC_CDN_URL=

# מלח לגיבוב היומי של מבקרים באנליטיקס העצמאי (page_views) — רשות.
# בלי זה נעשה שימוש בערך ברירת מחדל קבוע בקוד, שעדיין בטוח לשימוש (אין
# IP גולמי בטבלה בכל מקרה) אבל מלח ייחודי לסביבה שלכם מוסיף שכבת הגנה.
ANALYTICS_SALT=

# מזהה המדידה של Google Analytics 4 (מתחיל ב-G-) — רשות. בלי זה GA4
# פשוט לא נטען; האנליטיקס העצמאי למעלה ממשיך לעבוד בכל מקרה.
# הקמה: Google Analytics → Admin → Data Streams → Web.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# קאפצ'ה (reCAPTCHA v2, "אני לא רובוט") בטופס יצירת הקשר — רשות. בלי שני
# המפתחות האלה יחד, הקאפצ'ה פשוט לא מוצגת והטופס ממשיך לעבוד כרגיל עם
# מלכודת הבוט והגבלת הקצב הקיימות. הקמה: google.com/recaptcha/admin →
# יצירת אתר → reCAPTCHA v2 ("I'm not a robot" Checkbox).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# מפתח סוד — שרת בלבד, לעולם לא עם קידומת NEXT_PUBLIC_.
RECAPTCHA_SECRET_KEY=

# ============================================================================
# מסחר — מורנינג (חשבונית ירוקה), מייל ומשימות רקע. כולם שרת בלבד.
# ============================================================================

# מורנינג: כתובת ה-API. ברירת מחדל בקוד — Sandbox. בייצור:
# https://api.greeninvoice.co.il/api/v1  (הפרדה מלאה בין הסביבות!)
MORNING_API_BASE=

# מזהה מפתח API והסוד — מורנינג → הגדרות → API. שרת בלבד.
MORNING_API_KEY_ID=
MORNING_API_SECRET=

# סוד חתימת ה-Webhook — לאימות שההתראות באמת ממורנינג. שרת בלבד.
# בלעדיו נקודת ה-Webhook דוחה כל התראה (fail-closed).
MORNING_WEBHOOK_SECRET=

# [1.1] סוד ה-HMAC לגיבוב מזהי קשר (contact_hash של קופונים): ערך אקראי
# ארוך (32+ בייט, למשל: openssl rand -hex 32). בלעדיו נגזר סוד מ-service
# role key. אין לשנות אחרי עלייה לאוויר בלי תוכנית מעבר (מודל 3.14).
COMMERCE_HMAC_SECRET=

# ספק המייל (ערוץ הבסיס — פרק 15 באפיון): Resend. בלי המפתח, הודעות
# נרשמות ב-notification_log במצב skipped והזרימה הכספית ממשיכה כרגיל.
RESEND_API_KEY=
# כתובת השולח (דורשת אימות דומיין אצל הספק)
COMMERCE_EMAIL_FROM=

# סוד למשימות הרקע של המסחר (/api/cron/commerce): Polling גיבוי לתשלומים
# ושחרור שמירות מלאי שפגו. חובה כשהחנות פעילה.
#
# הערת תזמון: vercel.json מגדיר ריצה יומית בלבד — תוכנית Hobby של Vercel
# אינה מתירה cron תכוף יותר (הפריסה נכשלת). לפני הפעלת הסליקה בייצור
# נדרש אחד מהשניים: שדרוג ל-Vercel Pro ועדכון ה-schedule ל-*/10 * * * *,
# או מתזמן חיצוני (למשל cron-job.org / GitHub Actions) שקורא לנתיב כל
# 10 דקות עם Authorization: Bearer $CRON_SECRET. ריצה יומית מספיקה לשלבי
# הפיתוח, אך אינה מספיקה כגיבוי Webhook בחנות חיה (תנאי פתיחה, פרק 26).
CRON_SECRET=
NEXT_PUBLIC_CDN_URL=https://assets.kerenreem.org
NEXT_PUBLIC_CDN_URL=[https://assets.kerenreem.org](https://assets.kerenreem.org)
