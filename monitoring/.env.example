# [1.40] הגדרות מחסנית הניטור. להעתיק ל-.env ולמלא.
#
# ⚠️ הקובץ הזה יושב על **מכונת הניטור**, לא על שרת האפליקציה.
#    .env עצמו לעולם אינו נכנס ל-git.

# --- ערוצי התראה ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=monitor@kerenreem.org
# אפשר כמה כתובות מופרדות בפסיק. התראה שמגיעה לאדם אחד בלבד היא
# התראה שלא תיענה כשהוא בחופשה.
ALERT_EMAIL_TO=

# טלגרם — הערוץ שכן מעיר בשתיים בלילה. מייל לבדו אינו מספיק לקריטי.
# יצירת בוט: @BotFather → /newbot. מזהה הצ'אט: @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- webhook לוח האירועים --------------------------------------------------
# מקבל את ההתראות והופך אותן לאירועים עם ציר זמן.
# הסוד חייב להיות זהה ל-INCIDENT_WEBHOOK_SECRET שבהגדרות האפליקציה.
INCIDENT_WEBHOOK_URL=https://www.kerenreem.org/api/monitoring/incident
INCIDENT_WEBHOOK_SECRET=

# --- גישה לשרת האפליקציה ---------------------------------------------------
# כתובת **פרטית** במנהרה (WireGuard/Tailscale), לא כתובת ציבורית:
# מדדי שרת חשופים לאינטרנט הם מפת דרכים לתוקף.
# להחליף גם בקובץ prometheus/prometheus.yml (מופיע שם כ-APP_HOST).
APP_HOST=10.0.0.2

# משתמש קריאה-בלבד. ליצור פעם אחת במסד:
#   create user monitoring_ro with password '…';
#   grant pg_monitor to monitoring_ro;
# לעולם לא postgres ולא service_role.
PG_EXPORTER_DSN=postgresql://monitoring_ro:PASSWORD@localhost:5432/postgres?sslmode=disable

# --- בדיקות האפליקציה ------------------------------------------------------
MONITOR_BASE_URL=https://www.kerenreem.org
# ספר עוגן לבדיקות — slug של ספר שלא יימחק.
# להחליף גם ב-prometheus.yml (CANARY_BOOK_SLUG) וב-blackbox.yml
# (CANARY_EXPECTED_TEXT — טקסט שמופיע רק כשיש תוכן אמיתי בעמוד).
MONITOR_CANARY_BOOK=

# הסוד של /api/health/deep. להחליף גם ב-blackbox.yml, במקום
# HEALTH_CHECK_SECRET_PLACEHOLDER.
HEALTH_CHECK_SECRET=
